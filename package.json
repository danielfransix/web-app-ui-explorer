{
  "name": "@danielfransix/web-app-ui-explorer",
  "version": "0.6.0",
  "description": "Explore every screen and state of a web app: an automatic crawler, a source-driven explorer, a flow canvas and thumbnails. Works with any bundler and any front-end framework, or none.",
  "author": "Daniel Fransix",
  "license": "MIT",
  "homepage": "https://github.com/danielfransix/web-app-ui-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielfransix/web-app-ui-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/danielfransix/web-app-ui-explorer/issues"
  },
  "keywords": [
    "component-gallery",
    "crawler",
    "design",
    "playwright",
    "screens",
    "screenshots",
    "storybook-alternative",
    "ui",
    "ui-explorer",
    "vite",
    "vite-plugin",
    "bundler",
    "webpack",
    "create-react-app",
    "proxy",
    "web-app",
    "web-app-ui-explorer"
  ],
  "type": "module",
  "private": false,
  "bin": {
    "web-app-ui-explorer": "./dist/node/cli.js",
    "ui-explorer": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.js"
    }
  },
  "files": [
    "dist",
    "figma-plugin/manifest.json",
    "figma-plugin/code.js",
    "figma-plugin/ui.html",
    "figma-plugin/assets/OFL.txt",
    "docs/figma-plugin-guide.md",
    "docs/agent-orchestration.md",
    "docs/architecture.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && vite build --config vite.client.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "test:ui": "node --test --test-concurrency=2 test/copy-menu.test.mjs test/connection-details.test.mjs test/export-selection.test.mjs test/figma-connection.test.mjs test/handoff.test.mjs test/modal-hierarchy.test.mjs test/preview.test.mjs test/preview-performance.test.mjs test/responsive-preview.test.mjs test/screen-id-copy.test.mjs test/screen-picker.test.mjs test/shortcuts.test.mjs test/workbench-toolbar.test.mjs test/ui-principles.test.mjs",
    "ui-explorer": "node dist/node/cli.js",
    "demo": "npm run build && vite examples/vanilla-demo",
    "prepublishOnly": "npm run build && npm run figma-plugin:build && npm test",
    "test:matrix": "node test/matrix/run.mjs",
    "figma-plugin:typecheck": "tsc --noEmit -p figma-plugin/tsconfig.json && tsc --noEmit -p figma-plugin/tsconfig.ui.json",
    "figma-plugin:build": "npm run figma-plugin:typecheck && node figma-plugin/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clipboardy": "^5.3.2",
    "jsonc-parser": "^3.3.1",
    "playwright": "1.64.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@base-ui/react": "1.9.0",
    "@figma/plugin-typings": "^1.142.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "astro": "^7.4.0",
    "cookie": "^2.0.1",
    "elkjs": "0.12.0",
    "esbuild": "^0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
