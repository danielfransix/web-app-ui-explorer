{
  "name": "@danielfransix/web-app-ui-explorer",
  "version": "0.3.0",
  "description": "Explore every screen and state of a web app: an automatic crawler, a source-driven explorer, a flow canvas and thumbnails. Works with any bundler and any front-end framework, or none.",
  "author": "Daniel Fransix",
  "license": "MIT",
  "homepage": "https://github.com/danielfransix/web-app-ui-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielfransix/web-app-ui-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/danielfransix/web-app-ui-explorer/issues"
  },
  "keywords": [
    "component-gallery",
    "crawler",
    "design",
    "playwright",
    "screens",
    "screenshots",
    "storybook-alternative",
    "ui",
    "ui-explorer",
    "vite",
    "vite-plugin",
    "bundler",
    "webpack",
    "create-react-app",
    "proxy",
    "web-app",
    "web-app-ui-explorer"
  ],
  "type": "module",
  "private": false,
  "bin": {
    "web-app-ui-explorer": "./dist/node/cli.js",
    "ui-explorer": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && vite build --config vite.client.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "ui-explorer": "node dist/node/cli.js",
    "demo": "npm run build && vite examples/vanilla-demo",
    "prepublishOnly": "npm run build && npm test",
    "test:matrix": "node test/matrix/run.mjs"
  },
  "dependencies": {
    "playwright": "1.64.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "esbuild": "^0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
